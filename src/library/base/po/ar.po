msgid "trace, REPORT must be >= 0 (method = \"SANN\")"
msgstr "trace ، يجب أن يكون REPORT > = 0 (الطريقة = \"SANN\")"

#: src/appl/pretty.c:130
#, c-format
msgid "R_pretty(): infinite range; *ndiv=%d, should have ndiv >= 2"
