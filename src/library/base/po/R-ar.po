msgstr "العامل الثنائي + غير معرّف لكائنات \"Date\""

msgid "can only subtract from \"Date\" objects"
msgstr "لا يمكن إلا الطرح من كائنات \"Date\""

msgid "unary - is not defined for \"Date\" objects"
msgstr "العامل الأحادي - غير معرّف لكائنات \"Date\""

msgid "can only subtract numbers from \"Date\" objects"
msgstr "لا يمكن إلا طرح الأعداد من كائنات \"Date\""

msgid "unary %s not defined for \"Date\" objects"
msgstr "العامل الأحادي %s غير معرّف لكائنات \"Date\""

msgid "%s not defined for \"Date\" objects"
msgstr "%s غير معرّف لكائنات \"Date\""

msgid "'%s' must be of length 1"
msgstr "يجب أن يكون '%s' من طول 1"

msgid "without 'by', at least one of 'to' and 'from' must be specified"
msgstr "بدون 'by'، يجب تحديد واحد على الأقل من 'to' و'from'"

msgid "without 'by', when one of 'to', 'from' is missing, 'length.out' / 'along.with' must be specified"
msgstr "بدون 'by'، عندما يكون أحد 'to' أو 'from' مفقودًا، يجب تحديد 'length.out' / 'along.with'"

msgid "given 'by', exactly two of 'to', 'from' and 'length.out' / 'along.with' must be specified"
msgstr "عند تقديم 'by'، يجب تحديد اثنين فقط من 'to' و'from' و'length.out' / 'along.with'"

msgid "invalid 'by' string"
msgstr "سلسلة 'by' غير صالحة"

msgid "invalid string for 'by'"
msgstr "السلسلة الخاصة بـ 'by' غير صالحة"

msgid "invalid mode for 'by'"
msgstr "النمط الخاص بـ 'by' غير صالح"

