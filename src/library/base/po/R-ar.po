msgstr "لا يمكن أن يكون كلا وسيطي * من كائنات \"difftime\""

msgid "second argument of / cannot be a \"difftime\" object"
msgstr "لا يمكن أن يكون الوسيط الثاني لـ / كائن \"difftime\""

msgid "exactly three of 'to', 'from', 'by' and 'length.out' / 'along.with' must be specified"
msgstr "يجب تحديد ثلاثة بالضبط من 'to' و'from' و'by' و'length.out' / 'along.with'"

msgid "'%s' must be a \"%s\" object"
msgstr "يجب أن يكون '%s' كائن \"%s\""

msgid "component subscript must be a character string"
msgstr "يجب أن يكون فهرس المكوّن السفلي سلسلة نصية"

msgid "no Olson database found"
msgstr "لم يتم العثور على قاعدة بيانات Olson"

msgid "No element named \"%s\" found in x, did you mean x[, \"%1$s\"] instead?"
msgstr "لم يتم العثور على عنصر باسم \"%s\" في x، هل تقصد x[, \"%1$s\"] بدلًا من ذلك؟"

msgid "'file' must be a character string or connection"
msgstr "يجب أن يكون 'file' سلسلة نصية أو اتصال"

msgid ""
"Invalid DCF format.\n"
"Regular lines must have a tag.\n"
"Offending lines start with:\n"
"%s"
msgstr ""

msgid ""
"Invalid DCF format.\n"
"Continuation lines must not start a record.\n"
"Offending lines start with:\n"
"%s"
msgstr ""

msgid "failed to load the methods package for debugging by signature"
msgstr "فشل تحميل حزمة methods للتصحيح حسب التوقيع"

msgid "failed to load methods package for undebugging by signature"
msgstr "فشل تحميل حزمة methods لإلغاء التصحيح حسب التوقيع"

msgid "failed to load methods package for handling signature"
msgstr "فشل تحميل حزمة methods لمعالجة التوقيع"

msgid "'x' must be a square matrix"
msgstr "يجب أن يكون 'x' مصفوفة مربعة"

msgid "'determinant' not currently defined for complex matrices"
msgstr "'determinant' غير معرّف حاليًا للمصفوفات المركبة"

msgid "'nrow' or 'ncol' cannot be specified when 'x' is a matrix"
msgstr "لا يمكن تحديد 'nrow' أو 'ncol' عندما يكون 'x' مصفوفة"

msgid "'x' is an array, but not one-dimensional."
msgstr "'x' مصفوفة متعددة الأبعاد، لكنها ليست أحادية البعد."

msgid "only matrix diagonals can be replaced"
msgstr "لا يمكن استبدال إلا أقطار المصفوفة"

msgid "replacement diagonal has wrong length"
msgstr "قطر الاستبدال بطول غير صحيح"

msgid "MARGIN = %s is invalid for dim = %s"
msgstr "MARGIN = %s غير صالح لـ dim = %s"

msgid "must pass a package name, %s or %s object"
msgstr "يجب تمرير اسم حزمة أو كائن %s أو %s"

msgid "No DLL currently loaded with name or path %s"
msgstr "لا توجد DLL محمّلة حاليًا بالاسم أو المسار %s"

