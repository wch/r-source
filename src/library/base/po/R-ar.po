msgid "'%s' is defunct."
msgstr "'%s' لم يعد موجودا."

msgid "Use '%s' instead."
msgstr "استخدم '%s' بدلا من ذلك."

msgid "See help(\"Defunct\") and help(\"%s-defunct\")."
msgstr "راجع help(\"Defunct\") و help(\"%s-defunct\")."

msgid "See help(\"Defunct\")"
msgstr "انظر help(\"Defunct\")"

msgid "'%s' is deprecated."
msgstr "أصبح '%s' مهملًا."

msgid "See help(\"Deprecated\") and help(\"%s-deprecated\")."
msgstr "انظر help(\"Deprecated\") وhelp(\"%s-deprecated\") ."

msgid "See help(\"Deprecated\")"
msgstr "راجع help(\"Deprecated\")"

msgid "argument to 'La.svd' must be numeric or complex"
msgstr "يجب أن يكون الوسيط الممرر إلى 'La.svd' عددياً أو مركباً"

msgid "infinite or missing values in 'x'"
msgstr "القيم لانهائية أو مفقودة في 'x'"

msgid "a dimension is zero"
msgstr "البعد يساوي صفرا"

msgid "\"all\" and \"exact\" are mutually exclusive"
msgstr "\"all\" و \"exact\" يستبعد أحدهما الآخر"

msgid "\"hexNumeric\" and \"digits17\" are mutually exclusive"
msgstr "\"hexNumeric\" و \"digits17\" يستبعد أحدهما الآخر"

msgid "second argument must be a list"
msgstr "الوسيطة الثاني يجب أن يكون قائمة"

msgid "'iconvlist' is not available on this system"
msgstr "\"iconvlist\" غير متوفر على هذا النظام"

msgid "'kind' must be a character string (RNG to be used)."
msgstr "يجب أن يكون 'kind' سلسلة نصية (RNG المراد استخدامه)."

msgid "'%s' is not a valid abbreviation of an RNG"
msgstr "\"‎%s\" ليس اختصارا صالحا ل RNG"

msgid "'%s' must be a character string"
msgstr "يجب أن تكون \"%s\" سلسلة أحرف"

#, fuzzy
msgid "'%s' is not valid for '%s'"
msgstr "'%s' ليس خياراً صالحاً"

msgid "'%s' is not a valid choice"
msgstr "'%s' ليس خياراً صالحاً"

msgid "malformed version string"
msgstr "سلسلة إصدار مشوهة"

msgid "target is %s, current is %s"
msgstr "الهدف هو %s، والحالي هو %s"

msgid "'tolerance' should be numeric"
msgstr "ينبغي أن يكون 'tolerance' رقميًا"

msgid "'scale' should be numeric or NULL"
msgstr "ينبغي أن يكون 'scale' رقميًا أو NULL"

msgid "'%s' must be logical"
msgstr "يجب أن يكون '%s' منطقياً"

msgid "dim(X) must have a positive length"
msgstr "يجب أن يكون لـ dim(X) طول موجب"

msgid "'X' must have named dimnames"
msgstr "يجب أن تكون لـ 'X' أسماء أبعاد مسماة"

msgid "not all elements of 'MARGIN' are names of dimensions"
msgstr "ليست كل عناصر 'MARGIN' أسماءً للأبعاد"

msgid "'MARGIN' does not match dim(X)"
msgstr "لا يطابق 'MARGIN' قيمة dim(X)"

msgid "'dim' cannot be of length 0"
msgstr "لا يمكن أن يكون 'dim' من طول 0"

msgid "'dim' specifies too large an array"
msgstr "'dim' يحدد مصفوفة متعددة الأبعاد كبيرة جدًا"

msgid "'x' must have named dimnames"
msgstr "يجب أن تكون لـ 'x' أسماء أبعاد مسماة"

msgid "incorrect value for 'MARGIN'"
msgstr "قيمة 'MARGIN' غير صحيحة"

msgid "dim(x) must have a positive length"
msgstr "يجب أن يكون لـ dim(x) طول موجب"

msgid "'pos=1' is not possible and has been warned about for years"
msgstr "'pos=1' غير ممكن، وقد تم التحذير منه لسنوات"

msgid "file '%s' not found"
msgstr "لم يتم العثور على الملف '%s'"

msgid "invalid 'name' argument"
msgstr "الوسيط 'name' غير صالح"

msgid "package %s is required by %s, which may no longer work correctly"
msgstr "الحزمة %s مطلوبة بواسطة %s، والذي قد لا يعمل بشكل صحيح بعد الآن"

msgid "package %s is required by %s so will not be detached"
msgstr "الحزمة %s مطلوبة بواسطة %s لذلك لن يتم فصلها"

msgid ""
"%s failed in %s() for '%s', details:\n"
"  call: %s\n"
"  error: %s"
msgstr ""
"فشل %s في %s() لـ '%s'، التفاصيل:\n"
"  الاستدعاء: %s\n"
"  الخطأ: %s"

msgid "%s namespace cannot be unloaded:"
msgstr "لا يمكن إلغاء تحميل نطاق الأسماء %s:"

msgid "%s converted to character string"
msgstr "تم تحويل %s إلى سلسلة نصية"

msgid "replaced regular expression pattern '[' by  '\\\\['"
msgstr "تم استبدال نمط التعبير النمطي '[' بـ '\\\\['"

msgid "replaced '[<-' by '\\\\[<-' in regular expression pattern"
msgstr "تم استبدال '[<-' بـ '\\\\[<-' في نمط التعبير النمطي"

msgid "'value' must be a list"
msgstr "يجب أن يكون 'value' قائمة"

msgid "an object with that name already exists"
msgstr "يوجد بالفعل كائن بهذا الاسم"

msgid "autoloader did not find '%s' in '%s'"
msgstr "لم يعثر المحمّل التلقائي على '%s' في '%s'"

msgid "can only splice inside a call"
msgstr "لا يمكن إجراء splice إلا داخل استدعاء"

msgid "can only splice vectors"
msgstr "لا يمكن إجراء splice إلا للمتجهات"

msgid "the LINPACK argument has been defunct since R 3.1.0"
msgstr "أصبح وسيط LINPACK غير متاح منذ R 3.1.0"

msgid "complex matrices not permitted at present"
msgstr "المصفوفات المركبة غير مسموح بها حاليًا"

msgid "'x' must be an array of at least two dimensions"
msgstr "يجب أن يكون 'x' مصفوفة متعددة الأبعاد ببعدين على الأقل"

msgid "invalid 'dims'"
msgstr "'dims' غير صالح"

msgid "condition handlers must be specified with a condition class"
msgstr "يجب تحديد معالجات الشروط باستخدام صنف شرط"

msgid "no 'restart' '%s' found"
msgstr "لم يتم العثور على 'restart' '%s'"

msgid "not an interactive session"
msgstr "ليست جلسة تفاعلية"

msgid "not a valid restart specification"
msgstr "ليست مواصفة restart صالحة"

msgid "condition handlers must be functions"
msgstr "يجب أن تكون معالجات الشروط دوالًا"

msgid "pushing duplicate `%s` handler on top of the stack"
msgstr "دفع معالج `%s` مكرر إلى أعلى المكدس"

msgid "argument 'where' of length 0"
msgstr "الوسيط 'where' بطول 0"

msgid "can only write character objects"
msgstr "لا يمكن إلا كتابة الكائنات النصية"

msgid "'headers' must have names and must not be NA"
msgstr "يجب أن تكون لـ 'headers' أسماء وألا تكون NA"

msgid "'origin' must be one of 'start', 'current' or 'end'"
msgstr "يجب أن يكون 'origin' أحد 'start' أو 'current' أو 'end'"

msgid "can only truncate an open connection"
msgstr "لا يمكن إلا اقتطاع اتصال مفتوح"

msgid "invalid 'endian' argument"
msgstr "الوسيط 'endian' غير صالح"

msgid "can only write vector objects"
msgstr "لا يمكن إلا كتابة كائنات المتجهات"

msgid "'timeout' must be NULL or a non-negative number"
msgstr "يجب أن يكون 'timeout' إما NULL أو عددًا غير سالب"

msgid "'from' must be raw or character"
msgstr "يجب أن يكون 'from' من نوع raw أو character"

msgid "'x' must be numeric"
msgstr "يجب أن يكون \"x\" رقميا"

msgid "invalid number of intervals"
msgstr "عدد الفواصل غير صالح"

msgid "'breaks' are not unique"
msgstr "'breaks' ليست فريدة"

msgid "number of intervals and length of 'labels' differ"
msgstr "يختلف عدد الفواصل عن طول 'labels'"

msgid "invalid 'row.names' length"
msgstr "طول 'row.names' غير صالح"

msgid "invalid 'make.names'"
msgstr "'make.names' غير صالح"

msgid "duplicate 'row.names' are not allowed"
msgstr "لا يُسمح بتكرار 'row.names'"

msgid "missing values in 'row.names' are not allowed"
msgstr "لا يُسمح بالقيم المفقودة في 'row.names'"

msgid "invalid 'dimnames' given for data frame"
msgstr "تم تقديم 'dimnames' غير صالحة لإطار البيانات"

msgid "cannot coerce class %s to a data.frame"
msgstr "لا يمكن تحويل الصنف %s قسريًا إلى data.frame"

msgid "row names contain missing values"
msgstr "تحتوي أسماء الصفوف على قيم مفقودة"

msgid "'row.names' is not a character or integer vector of length %d"
msgstr "يجب أن يكون 'row.names' متجهًا نصيًا أو صحيحًا بطول %d"

msgid "mismatch of row names in arguments of 'data.frame', item %d"
msgstr "عدم تطابق أسماء الصفوف في وسائط 'data.frame'، العنصر %d"

msgid "some row.names duplicated: %s --> row.names NOT used"
msgstr "بعض row.names مكررة: %s --> لم تُستخدم row.names"

msgid "duplicate row.names: %s"
msgstr "row.names مكررة: %s"

msgid "arguments imply differing number of rows: %s"
msgstr "تشير الوسائط إلى عدد مختلف من الصفوف: %s"

msgid "'row.names' should specify one of the variables"
msgstr "ينبغي أن يحدد 'row.names' أحد المتغيرات"

msgid "row names supplied are of the wrong length"
msgstr "أسماء الصفوف المقدمة ذات طول غير صحيح"

msgid "row names were found from a short variable and have been discarded"
msgstr "تم العثور على أسماء الصفوف من متغير قصير وتم تجاهلها"

msgid "named arguments other than 'drop' are discouraged"
msgstr "لا يُنصح باستخدام وسائط مسماة غير 'drop'"

msgid "'drop' argument will be ignored"
msgstr "سيتم تجاهل الوسيط 'drop'"

msgid "undefined columns selected"
msgstr "تم اختيار أعمدة غير معرّفة"

msgid "named arguments other than 'exact' are discouraged"
msgstr "لا يُنصح باستخدام وسائط مسماة غير 'exact'"

msgid "named arguments are discouraged"
msgstr "لا يُنصح باستخدام الوسائط المسماة"

msgid "number of items to replace is not a multiple of replacement length"
msgstr "number من items إلى replace ليس multiple من replacement طول"

msgid "'value' is the wrong length"
msgstr "'value' بطول غير صحيح"

msgid "unsupported matrix index in replacement"
msgstr "فهرس مصفوفة غير مدعوم في الاستبدال"

msgid "need 0, 1, or 2 subscripts"
msgstr "يلزم 0 أو 1 أو 2 من الفهارس السفلية"

msgid "missing values are not allowed in subscripted assignments of data frames"
msgstr "لا يُسمح بالقيم المفقودة في الإسنادات المفهرسة لإطارات البيانات"

msgid "non-existent rows not allowed"
msgstr "لا يُسمح بصفوف غير موجودة"

msgid "column name \"\" cannot match any column"
msgstr "لا يمكن لاسم العمود \"\" أن يطابق أي عمود"

msgid "new columns would leave holes after existing columns"
msgstr "ستترك الأعمدة الجديدة فجوات بعد الأعمدة الموجودة"

msgid "duplicate subscripts for columns"
msgstr "فهارس سفلية مكررة للأعمدة"

msgid "only valid calls are x[[j]] <- value or x[[i,j]] <- value"
msgstr "الاستدعاءات الصالحة فقط هي x[[j]] <- value أو x[[i,j]] <- value"

msgid "replacing element in non-existent column: %s"
msgstr "استبدال عنصر في عمود غير موجود: %s"

msgid "only a single element should be replaced"
msgstr "ينبغي استبدال عنصر واحد فقط"

msgid "names do not match previous names"
msgstr "الأسماء لا تطابق الأسماء السابقة"

msgid "numbers of columns of arguments do not match"
msgstr "أعداد أعمدة الوسائط غير متطابقة"

msgid "invalid list argument: all variables should have the same length"
msgstr "وسيط القائمة غير صالح: ينبغي أن تكون جميع المتغيرات بالطول نفسه"

msgid "number of columns of result, %d, is not a multiple of vector length %d of arg %d"
msgstr "عدد أعمدة النتيجة، %d، ليس مضاعفًا لطول المتجه %d للوسيط %d"

msgid "<0 rows> (or 0-length row.names)"
msgstr "<0 صفوف> (أو row.names بطول 0)"

msgid "invalid 'max' / getOption(\"max.print\"):"
msgstr "'max' / getOption(\"max.print\") غير صالح:"

msgid "non-numeric-alike variable(s) in data frame:"
msgstr "متغيرات غير شبيهة بالرقمية في إطار البيانات:"

msgid "%s only defined for equally-sized data frames"
msgstr "%s معرّف فقط لإطارات البيانات ذات الحجم نفسه"

msgid "list of length %d not meaningful"
msgstr "القائمة ذات الطول %d غير ذات معنى"

msgid "only defined on a data frame with all numeric-alike variables"
msgstr "مُعرّف فقط على إطار بيانات تكون جميع متغيراته شبيهة بالرقمية"

msgid "cannot xtfrm data frames"
msgstr "لا يمكن تطبيق xtfrm على إطارات البيانات"

msgid "all variables should have the same length"
msgstr "ينبغي أن تكون جميع المتغيرات بالطول نفسه"

