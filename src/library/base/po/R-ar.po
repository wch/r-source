msgstr "يجب أن يكون 'x' كائن تاريخ-وقت"

msgid "invalid specification of 'breaks'"
msgstr "مواصفة 'breaks' غير صالحة"

msgid "'lag' and 'differences' must be integers >= 1"
msgstr "يجب أن يكون 'lag' و'differences' عددين صحيحين >= 1"

msgid "unable to deduce timezone name from"
msgstr "تعذر استنتاج اسم المنطقة الزمنية من"

msgid "wrong class"
msgstr "صنف غير صحيح"

msgid "binary '+' is not defined for \"POSIXt\" objects"
msgstr "العامل الثنائي '+' غير معرّف لكائنات \"POSIXt\""

msgid "can only subtract from \"POSIXt\" objects"
msgstr "لا يمكن إلا الطرح من كائنات \"POSIXt\""

msgid "unary '-' is not defined for \"POSIXt\" objects"
msgstr "العامل الأحادي '-' غير معرّف لكائنات \"POSIXt\""

msgid "can only subtract numbers from \"POSIXt\" objects"
msgstr "لا يمكن إلا طرح الأعداد من كائنات \"POSIXt\""

msgid "unary '%s' not defined for \"POSIXt\" objects"
msgstr "العامل الأحادي '%s' غير معرّف لكائنات \"POSIXt\""

msgid "'%s' not defined for \"POSIXt\" objects"
msgstr "'%s' غير معرّف لكائنات \"POSIXt\""

msgid "'tzone' attributes are inconsistent"
msgstr "سمات 'tzone' غير متسقة"

msgid "as.character(td, ..) no longer obeys a 'format' argument; use format(td, ..) ?"
msgstr "لم يعد as.character(td, ..) يلتزم بوسيط 'format'؛ هل تستخدم format(td, ..)؟"

msgid "'digits' must be numeric, integer valued"
msgstr "يجب أن يكون 'digits' رقميًا ذا قيمة صحيحة"

msgid "'tim' is not character or numeric"
msgstr "'tim' ليس نصيًا ولا رقميًا"

msgid "need explicit units for numeric conversion"
msgstr "يلزم تحديد وحدات صريحة للتحويل الرقمي"

msgid "invalid units specified"
msgstr "تم تحديد وحدات غير صالحة"

msgid "unary '%s' not defined for \"difftime\" objects"
msgstr "العامل الأحادي '%s' غير معرّف لكائنات \"difftime\""

msgid "'%s' not defined for \"difftime\" objects"
msgstr "'%s' غير معرّف لكائنات \"difftime\""

