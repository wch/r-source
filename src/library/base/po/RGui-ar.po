#: src/extra/graphapp/clipboard.c:79
msgid "Unable to open the clipboard"
msgstr "تعذّر فتح الحافظة"

#: src/gnuwin32/console.c:2133
msgid "Insufficient memory. Please close the console"
msgstr "الذاكرة غير كافية. يرجى إغلاق وحدة التحكم"

#: src/gnuwin32/console.c:2189 src/gnuwin32/console.c:2243
#: src/gnuwin32/preferences.c:347
#, c-format
msgid ""
"Font %s-%d-%d  not found.\n"
"Using system fixed font"
msgstr ""
"لم يُعثر على الخط %s-%d-%d.\n"
"سيُستخدم خط النظام ثابت العرض"

#: src/gnuwin32/console.c:2348
msgid "Save selection to"
msgstr "حفظ التحديد إلى"

#: src/gnuwin32/console.c:2350
msgid "Save console contents to"
msgstr "حفظ محتويات وحدة التحكم إلى"

#: src/gnuwin32/console.c:2457
msgid "Scrolling.\n"
msgstr "التمرير.\n"

#: src/gnuwin32/console.c:2458
msgid "  Keyboard: PgUp, PgDown, Ctrl+Arrows, Ctrl+Home, Ctrl+End,\n"
msgstr "  لوحة المفاتيح: PgUp وPgDown وCtrl+Arrows وCtrl+Home وCtrl+End،\n"

#: src/gnuwin32/console.c:2459
msgid ""
"  Mouse: use the scrollbar(s).\n"
"\n"
msgstr ""
"  الفأرة: استخدم شريط/أشرطة التمرير.\n"
"\n"

#: src/gnuwin32/console.c:2460
msgid "Editing.\n"
msgstr "التحرير.\n"

#: src/gnuwin32/console.c:2461
msgid "  Moving the cursor: \n"
msgstr "  تحريك المؤشر: \n"

#: src/gnuwin32/console.c:2462
msgid "     Left arrow or Ctrl+B: move backward one character;\n"
msgstr "     السهم الأيسر أو Ctrl+B: التحرك للخلف بمقدار حرف واحد؛\n"

#: src/gnuwin32/console.c:2463
msgid "     Right arrow or Ctrl+F: move forward one character;\n"
msgstr "     السهم الأيمن أو Ctrl+F: التحرك للأمام بمقدار حرف واحد؛\n"

#: src/gnuwin32/console.c:2464
msgid "     Home or Ctrl+A: go to beginning of line;\n"
msgstr "     Home أو Ctrl+A: الانتقال إلى بداية السطر؛\n"

#: src/gnuwin32/console.c:2465
msgid "     End or Ctrl+E: go to end of line;\n"
msgstr "     End أو Ctrl+E: الانتقال إلى نهاية السطر؛\n"

#: src/gnuwin32/console.c:2466
msgid "  History: Up and Down Arrows, Ctrl+P, Ctrl+N\n"
msgstr "  السجل: السهمان للأعلى وللأسفل، Ctrl+P، Ctrl+N\n"

#: src/gnuwin32/console.c:2467
msgid "  Deleting:\n"
msgstr "  الحذف:\n"

#: src/gnuwin32/console.c:2468
msgid "     Del or Ctrl+D: delete current character or selection;\n"
msgstr "     Del أو Ctrl+D: حذف الحرف الحالي أو التحديد؛\n"

#: src/gnuwin32/console.c:2469
msgid "     Backspace: delete preceding character;\n"
msgstr "     Backspace: حذف الحرف السابق؛\n"

#: src/gnuwin32/console.c:2470
msgid "     Ctrl+Del or Ctrl+K: delete text from current character to end of line.\n"
msgstr "     Ctrl+Del أو Ctrl+K: حذف النص من الحرف الحالي إلى نهاية السطر.\n"

#: src/gnuwin32/console.c:2471
msgid "     Ctrl+U: delete all text from current line.\n"
msgstr "     Ctrl+U: حذف كل النص من السطر الحالي.\n"

#: src/gnuwin32/console.c:2472
msgid "  Copy and paste.\n"
msgstr "  النسخ واللصق.\n"

#: src/gnuwin32/console.c:2473
msgid "     Use the mouse (with the left button held down) to mark (select) text.\n"
msgstr "     استخدم الفأرة (مع الضغط المستمر على الزر الأيسر) لتعليم النص (تحديده).\n"

#: src/gnuwin32/console.c:2474
msgid "     Use Shift+Del (or Ctrl+C) to copy the marked text to the clipboard and\n"
msgstr "     استخدم Shift+Del (أو Ctrl+C) لنسخ النص المحدد إلى الحافظة و\n"

#: src/gnuwin32/console.c:2475
msgid "     Shift+Ins (or Ctrl+V or Ctrl+Y) to paste the content of the clipboard (if any)  \n"
msgstr "     Shift+Ins (أو Ctrl+V أو Ctrl+Y) للصق محتوى الحافظة (إن وجد)  \n"

#: src/gnuwin32/console.c:2476
msgid "     to the console, Ctrl+X first copy then paste\n"
msgstr "     في وحدة التحكم، وCtrl+X ينسخ أولًا ثم يلصق\n"

#: src/gnuwin32/console.c:2477
msgid "  Misc:\n"
msgstr "  متفرقات:\n"

#: src/gnuwin32/console.c:2478
msgid "     Ctrl+L: Clear the console.\n"
msgstr "     Ctrl+L: مسح وحدة التحكم.\n"

#: src/gnuwin32/console.c:2479
msgid "     Ctrl+O or INS: Toggle overwrite mode: initially off.\n"
msgstr "     Ctrl+O أو INS: تبديل نمط الاستبدال: متوقف في البداية.\n"

#: src/gnuwin32/console.c:2480
msgid "     Ctrl+T: Interchange current char with one to the left.\n"
msgstr "     Ctrl+T: تبديل الحرف الحالي مع الحرف الذي على يساره.\n"

#: src/gnuwin32/console.c:2481
msgid ""
"\n"
"Note: Console is updated only when some input is required.\n"
msgstr ""
"\n"
"ملاحظة: تُحدَّث وحدة التحكم فقط عند الحاجة إلى إدخال.\n"

#: src/gnuwin32/console.c:2482
msgid ""
"  Use Ctrl+W to toggle this feature off/on.\n"
"\n"
msgstr ""
"  استخدم Ctrl+W لتبديل هذه الميزة إيقافًا/تشغيلًا.\n"
"\n"

#: src/gnuwin32/console.c:2483
msgid ""
"Use ESC to stop the interpreter.\n"
"\n"
msgstr ""
"استخدم ESC لإيقاف المفسر.\n"
"\n"

#: src/gnuwin32/console.c:2484
msgid ""
"TAB starts completion of the current word.\n"
"\n"
msgstr ""
"يبدأ TAB إكمال الكلمة الحالية.\n"
"\n"

#: src/gnuwin32/console.c:2485
msgid "Standard Windows hotkeys can be used to switch to the\n"
msgstr "يمكن استخدام مفاتيح الاختصار القياسية في Windows للتبديل إلى\n"

#: src/gnuwin32/console.c:2486
msgid "graphics device (Ctrl+Tab or Ctrl+F6 in MDI, Alt+Tab in SDI)"
msgstr "جهاز الرسوميات (Ctrl+Tab أو Ctrl+F6 في MDI، وAlt+Tab في SDI)"

