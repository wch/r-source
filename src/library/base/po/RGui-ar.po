msgstr "     اختر \"تشغيل السطر أو التحديد\" من قائمة \"تحرير\"\n"

#: src/gnuwin32/editor.c:726
msgid "     Press the \"Run line or selection\" icon on the toolbar\n"
msgstr "     اضغط أيقونة \"تشغيل السطر أو التحديد\" في شريط الأدوات\n"

#: src/gnuwin32/editor.c:727
