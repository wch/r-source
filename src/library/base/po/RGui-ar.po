msgstr "محرر نصوص قياسي لتحرير كود R وتشغيله.\n"

#: src/gnuwin32/editor.c:722
msgid "RUNNING COMMANDS\n"
msgstr "تشغيل الأوامر\n"

#: src/gnuwin32/editor.c:723
msgid "To run a line or section of R code, select the code and either\n"
msgstr "لتشغيل سطر أو قسم من كود R، حدد الكود ثم إما\n"

#: src/gnuwin32/editor.c:724
msgid "     Press Ctrl-R\n"
msgstr "     اضغط Ctrl-R\n"

#: src/gnuwin32/editor.c:725
