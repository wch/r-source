msgid ""
"RShowDoc() should be used with a character string argument specifying\n"
"   a documentation file"
msgstr ""

msgid "no documentation for %s found in package %s"
msgstr "لم يتم العثور على توثيق لـ %s في الحزمة %s"

msgid "document not found"
msgstr "لم يتم العثور على المستند"

msgid "some options in argument 'restrict' were not recognized and hence ignored"
msgstr "لم يتم التعرف على بعض الخيارات في الوسيط 'restrict' ولذلك تم تجاهلها"

msgid "argument 'format' is deprecated and has no effect on search results"
msgstr "الوسيط 'format' مهمل وليس له تأثير في نتائج البحث"

msgid "A search query has been submitted to %s"
msgstr "تم إرسال استعلام بحث إلى %s"

msgid "The results page should open in your browser shortly"
msgstr "ينبغي أن تفتح صفحة النتائج في متصفحك بعد قليل"

msgid "reference to unknown chunk %s"
msgstr "إشارة إلى مقطع غير معروف %s"

msgid "no Sweave file with name %s found"
msgstr "لم يتم العثور على ملف Sweave بالاسم %s"

msgid "more than one syntax specification found, using the first one"
msgstr "تم العثور على أكثر من مواصفة صياغة؛ سيُستخدم أولها"

msgid "object %s does not have class \"SweaveSyntax\""
msgstr "الكائن %s ليس من الصنف \"SweaveSyntax\""

msgid "recursive Sweave input %s in stack"
msgstr "إدخال Sweave عودي %s في المكدس"

msgid "target syntax not of class %s"
msgstr "صياغة الهدف ليست من الصنف %s"

msgid "target syntax contains no translation table"
msgstr "صياغة الهدف لا تحتوي على جدول ترجمة"

msgid ""
"parse error or empty option in\n"
"%s"
msgstr ""
"خطأ في التحليل أو خيار فارغ في\n"
"%s"

msgid "Warning: unknown option '--clean='%s"
msgstr "تحذير: خيار غير معروف '--clean='%s"

msgid "Warning: unknown option %s"
msgstr "تحذير: خيار غير معروف %s"

msgid "Compacting PDF document"
msgstr "جارٍ ضغط مستند PDF"

msgid "path to %s contains spaces,"
msgstr "المسار إلى %s يحتوي على مسافات،"

msgid "this may cause problems when running LaTeX"
msgstr "قد يسبب هذا مشكلات عند تشغيل LaTeX"

msgid "the output file '%s' has disappeared"
msgstr "اختفى ملف الإخراج '%s'"

msgid "invalid value for %s : %s"
msgstr "قيمة غير صالحة لـ %s : %s"

#, fuzzy
msgid "value of option 'results' should be lowercase"
msgstr "ينبغي أن تكون قيمة خيار 'results' بحروف صغيرة"

#, fuzzy
msgid "value of option 'strip.white' should be lowercase"
msgstr "ينبغي أن تكون قيمة خيار 'strip.white' بحروف صغيرة"

msgid "using default value %s"
msgstr "جارٍ استخدام القيمة الافتراضية %s"

msgid "this function cannot be used from an interactive session"
msgstr "لا يمكن استخدام هذه الدالة من جلسة تفاعلية"

msgid "unrecognized Sweave call"
msgstr "استدعاء Sweave غير معروف"

msgid "elements of 'what' after the first will be ignored"
msgstr "سيتم تجاهل عناصر 'what' بعد العنصر الأول"

msgid "Yes"
msgstr "نعم"

msgid "No"
msgstr "لا"

msgid "Cancel"
msgstr "إلغاء"

msgid "Unrecognized response"
msgstr "استجابة غير معروفة"

msgid "No suitable spell-checker program found"
msgstr "لم يتم العثور على برنامج مناسب للتدقيق الإملائي"

msgid "Filter '%s' is not available."
msgstr "المرشح '%s' غير متاح."

msgid "Invalid 'filter' argument."
msgstr "الوسيط 'filter' غير صالح."

msgid ""
"The following dictionaries were not found:\n"
"%s"
msgstr ""
"لم يتم العثور على القواميس التالية:\n"
"%s"

msgid "Processing file %s"
msgstr "جارٍ معالجة الملف %s"

msgid ""
"Running aspell failed with diagnostics:\n"
"%s"
msgstr ""
"فشل تشغيل aspell مع التشخيصات:\n"
"%s"

msgid "No suitable spell check program found."
msgstr "لم يتم العثور على برنامج مناسب للتدقيق الإملائي."

msgid "Performing query %s"
msgstr "جارٍ تنفيذ الاستعلام %s"

msgid "Unsupported object"
msgstr "كائن غير مدعوم"

msgid ""
"Use <code> %s </code> \n"
" to list the vignettes in all <strong>available</strong> packages."
msgstr ""
"استخدم <code> %s </code> \n"
" لسرد الـ vignettes في جميع الحزم <strong>المتاحة</strong>."

msgid "No vignettes found by %s"
msgstr "لم يتم العثور على vignettes بواسطة %s"

msgid "Package %s: DESCRIPTION file not found"
msgstr "الحزمة %s: لم يتم العثور على ملف DESCRIPTION"

msgid "'file' must be NULL, a character string or a connection"
msgstr "يجب أن يكون 'file' هو NULL أو سلسلة نصية أو اتصالًا"

msgid "'full.names' must be TRUE for multiple paths."
msgstr "يجب أن يكون 'full.names' هو TRUE عند وجود مسارات متعددة."

msgid "Timestamp file no longer exists."
msgstr "ملف الطابع الزمني لم يعد موجودًا."

msgid "Not all arguments are of the same length, the following need to be recycled: %s"
msgstr "ليست كل الوسائط بالطول نفسه؛ العناصر التالية تحتاج إلى إعادة تدوير: %s"

msgid "Use either %s or %s/%s but not both."
msgstr "استخدم إما %s أو %s/%s ولكن ليس كليهما."

msgid "It is recommended to use %s instead of %s."
msgstr "يوصى باستخدام %s بدلًا من %s."

msgid "Use either %s or %s but not both."
msgstr "استخدم إما %s أو %s ولكن ليس كليهما."

msgid "Arguments of person() should be character or NULL"
msgstr "يجب أن تكون وسائط person() نصية أو NULL"

msgid "subscript out of bounds"
msgstr "الكتابة السفلية خارج الحدود"

msgid "must have some non-empty fields"
msgstr "يجب أن تحتوي على بعض الحقول غير الفارغة"

msgid "method is only applicable to %s objects"
msgstr "الطريقة قابلة للتطبيق فقط على كائنات %s"

msgid "all arguments must be of class %s"
msgstr "يجب أن تكون كل الوسائط من الصنف %s"

msgid "all fields have to be named"
msgstr "يجب تسمية جميع الحقول"

msgid "%s has to be one of %s"
msgstr "يجب أن يكون %s واحدًا من %s"

msgid "%s should be one of %s"
msgstr "ينبغي أن يكون %s واحدًا من %s"

msgid "To cite package %s in publications use:"
msgstr "للاستشهاد بالحزمة %s في المنشورات استخدم:"

msgid "A BibTeX entry for LaTeX users is"
msgstr "مدخل BibTeX لمستخدمي LaTeX هو"

msgid ""
"Dropping invalid entry %d:\n"
"%s"
msgstr ""
"إسقاط المدخل غير الصالح %d:\n"
"%s"

msgid "package %s has no %s file: only auto-generation is possible"
msgstr "الحزمة %s لا تحتوي على ملف %s: لا يمكن إلا التوليد التلقائي"

msgid "could not determine year for %s from package DESCRIPTION file"
msgstr "تعذّر تحديد السنة لـ %s من ملف DESCRIPTION الخاص بالحزمة"

msgid "ATTENTION: This citation information has been auto-generated from the package DESCRIPTION file and may need manual editing, see %s."
msgstr ""

msgid "'FUN' must be a function or NULL"
msgstr "يجب أن يكون 'FUN' دالة أو NULL"

msgid "cannot handle S4 methods yet"
msgstr "لا يمكن التعامل مع طرق S4 حتى الآن"

msgid "'package' must be a character vector or NULL"
msgstr "يجب أن يكون 'package' متجهًا نصيًا أو NULL"

msgid "data index for package %s is invalid and will be ignored"
msgstr "فهرس البيانات للحزمة %s غير صالح وسيتم تجاهله"

msgid "data set %s not found"
msgstr "لم يتم العثور على مجموعة البيانات %s"

msgid "an object named %s already exists and will not be overwritten"
msgstr "يوجد كائن بالاسم %s مسبقًا ولن تتم الكتابة فوقه"

msgid "only 'html = TRUE' is supported on this platform"
msgstr "لا يُدعم إلا 'html = TRUE' على هذه المنصة"

msgid "kind '%s' not yet implemented"
msgstr "النوع '%s' لم يُنفذ بعد"

msgid "wrong number of table row entries"
msgstr "عدد مدخلات صف الجدول غير صحيح"

msgid "wrong argument to 'dataentry'"
msgstr "وسيط غير صحيح إلى 'dataentry'"

msgid "could not restore type information"
msgstr "تعذّر استعادة معلومات النوع"

msgid "'modes' argument ignored"
msgstr "تم تجاهل الوسيط 'modes'"

msgid "'names' argument ignored"
msgstr "تم تجاهل الوسيط 'names'"

msgid "could not restore variables properly"
msgstr "تعذّرت استعادة المتغيرات بشكل صحيح"

msgid "did not assign() anything"
msgstr "لم يُعيّن assign() أي شيء"

msgid "Cannot debug primitive functions unless they are implicit generics (requires loading the methods package)"
msgstr "لا يمكن تنقيح الدوال البدائية إلا إذا كانت دوال عامة ضمنية (يتطلب تحميل حزمة methods)"

msgid "error in trying to evaluate the expression for argument %s (%s)"
msgstr "خطأ أثناء محاولة تقييم التعبير للوسيط %s ‏(%s)"

msgid "Browsing in the environment with call:"
msgstr "تصفح في البيئة ذات الاستدعاء:"

msgid "'dump' is not an object of class %s"
msgstr "'dump' ليس كائنًا من الصنف %s"

msgid "Message:"
msgstr "الرسالة:"

msgid "'dump' is empty"
msgstr "'dump' فارغ"

msgid "Available environments had calls:"
msgstr "كانت البيئات المتاحة ذات الاستدعاءات:"

msgid "Enter an environment number, or 0 to exit"
msgstr "أدخل رقم بيئة، أو 0 للخروج"

msgid "recover called non-interactively; frames dumped, use debugger() to view"
msgstr "تم استدعاء recover بشكل غير تفاعلي؛ تم تفريغ الإطارات، استخدم debugger() للعرض"

msgid "Enter a frame number, or 0 to exit"
msgstr "أدخل رقم إطار، أو 0 للخروج"

msgid "No suitable frames for recover()"
msgstr "لا توجد إطارات مناسبة لـ recover()"

msgid "No demo found for topic %s"
msgstr "لم يتم العثور على عرض توضيحي للموضوع %s"

msgid ""
"Demo for topic %s' found more than once,\n"
"using the one found in %s"
msgstr ""
"تم العثور على عرض توضيحي للموضوع %s أكثر من مرة،\n"
"سيُستخدم الموجود في %s"

msgid "invalid 'data' argument"
msgstr "'data' غير صالح"

msgid "invalid 'modes' argument"
msgstr "الوسيط 'modes' غير صالح"

msgid "invalid 'x' argument"
msgstr "الوسيط 'x' غير صالح"

msgid "can only handle vector and factor elements"
msgstr "يمكن التعامل فقط مع عناصر المتجهات والعوامل"

msgid "invalid factor levels in '%s'"
msgstr "مستويات عامل غير صالحة في '%s'"

msgid "added factor levels in '%s'"
msgstr "تمت إضافة مستويات عامل في '%s'"

msgid "edited row names contain duplicates and will be ignored"
msgstr "تحتوي أسماء الصفوف المحررة على تكرارات وسيتم تجاهلها"

msgid "invalid input matrix"
msgstr "مصفوفة الإدخال غير صالحة"

msgid "class of 'name' will be discarded"
msgstr "سيتم إسقاط صنف 'name'"

msgid "cannot edit NULL row names"
msgstr "لا يمكن تحرير أسماء صفوف NULL"

msgid "no help found for %s"
msgstr "لم يتم العثور على مساعدة لـ %s"

msgid "%s has a help file but no examples"
msgstr "%s لديه ملف مساعدة ولكن لا توجد أمثلة"

msgid "Line number missing"
msgstr "رقم السطر مفقود"

msgid "'fix' requires a name"
msgstr "'fix' يتطلب اسمًا"

msgid "too many list items (at most up to %d)"
msgstr "عدد عناصر القائمة كبير جدًا (حتى %d كحد أقصى)"

msgid "no vector columns were selected"
msgstr "لم يتم اختيار أي أعمدة متجهية"

msgid "non-vector columns will be ignored"
msgstr "سيتم تجاهل الأعمدة غير المتجهية"

msgid "at least one vector element is required"
msgstr "يلزم عنصر متجهي واحد على الأقل"

msgid "non-vector elements will be ignored"
msgstr "سيتم تجاهل العناصر غير المتجهية"

msgid "'form' must be a two-sided formula"
msgstr "يجب أن تكون 'form' صيغة ذات طرفين"

msgid "'form' must be a two-sided formula with one term on each side"
msgstr "يجب أن تكون 'form' صيغة ذات طرفين وبحد واحد في كل طرف"

msgid "invalid object for 'as.environment'"
msgstr "كائن لـ 'as.environment' غير صالح"

msgid "invalid 'n' - must contain at least one non-missing element, got none."
msgstr "القيمة 'n' غير صالحة - يجب أن تحتوي على عنصر واحد غير مفقود على الأقل، ولم يُعطَ أي عنصر."

msgid "invalid 'n' - must be numeric, possibly NA."
msgstr "القيمة 'n' غير صالحة - يجب أن تكون رقمية، وربما NA."

msgid "invalid 'n' - must have length one when dim(x) is NULL, got %d"
msgstr "القيمة 'n' غير صالحة - يجب أن يكون طولها واحدًا عندما تكون dim(x) هي NULL، وتم الحصول على %d"

msgid "invalid 'n' - length(n) must be <= length(dim(x)), got %d > %d"
msgstr "القيمة 'n' غير صالحة - يجب أن يكون length(n) <= length(dim(x))، وتم الحصول على %d > %d"

msgid "no method found for %s(., n=%s) and class %s"
msgstr "لم يتم العثور على طريقة لـ %s(., n=%s) والصنف %s"

msgid ""
"tail(., addrownums = V) is deprecated.\n"
"Use"
msgstr ""
"tail(., addrownums = V) مهمل.\n"
"استخدم"

msgid "tail(., keepnums = V) instead."
msgstr "tail(., keepnums = V) بدلًا من ذلك."

msgid "tail(., addrownums=.) is"
msgstr "tail(., addrownums=.) هو"

msgid ""
"deprecated.\n"
"Use"
msgstr ""
"مهمل.\n"
"استخدم"

msgid "tail(., keepnums=.) instead."
msgstr "tail(., keepnums=.) بدلًا من ذلك."

msgid "'topic' should be a name, length-one character vector or reserved word"
msgstr "ينبغي أن يكون 'topic' اسمًا، أو متجهًا نصيًا بطول واحد، أو كلمة محجوزة"

msgid "No documentation for %s in specified packages and libraries:"
msgstr "لا يوجد توثيق لـ %s في الحزم والمكتبات المحددة:"

msgid "you could try %s"
msgstr "يمكنك تجربة %s"

msgid "Help for topic %s is not in any loaded package but can be found in the following packages:"
msgstr "المساعدة للموضوع %s ليست في أي حزمة محملة، ولكن يمكن العثور عليها في الحزم التالية:"

msgid "Package"
msgstr "الحزمة"

msgid "Library"
msgstr "المكتبة"

msgid "Help on topic %s was found in the following packages:"
msgstr "تم العثور على مساعدة للموضوع %s في الحزم التالية:"

msgid "Choose one"
msgstr "اختر واحدًا"

msgid "Using the first match ..."
msgstr "جارٍ استخدام أول تطابق ..."

msgid "HTML help is unavailable"
msgstr "مساعدة HTML غير متاحة"

msgid "R Help on %s"
msgstr "مساعدة R حول %s"

msgid "invalid %s argument"
msgstr "الوسيطة %s غير صالحة"

msgid "package %s exists but was not installed under R >= 2.10.0 so help cannot be accessed"
msgstr "الحزمة %s موجودة ولكن لم يتم تثبيتها تحت R >= 2.10.0، لذلك لا يمكن الوصول إلى المساعدة"

msgid "creation of %s failed"
msgstr "فشل إنشاء %s"

msgid "Saving help page to %s"
msgstr "جارٍ حفظ صفحة المساعدة إلى %s"

msgid "Cancelled by user"
msgstr "ألغى المستخدم العملية"

msgid "Unable to connect to CRAN to check R version."
msgstr "تعذّر الاتصال بـ CRAN للتحقق من إصدار R."

msgid "'%s' must be a character string"
msgstr "يجب أن تكون \"%s\" سلسلة أحرف"

msgid "incorrect field specification"
msgstr "مواصفة الحقل غير صحيحة"

msgid "do not know what to search"
msgstr "لا أعرف ما الذي يجب البحث عنه"

msgid "argument 'help.db' is deprecated"
msgstr "الوسيط 'help.db' مهمل"

msgid "incorrect type specification"
msgstr "مواصفة النوع غير صحيحة"

msgid "no information in the database for package %s: need 'rebuild = TRUE'?"
msgstr "لا توجد معلومات في قاعدة البيانات للحزمة %s: هل تحتاج إلى 'rebuild = TRUE'؟"

msgid "incorrect 'agrep' specification"
msgstr "مواصفة 'agrep' غير صحيحة"

msgid "package %s has empty hsearch data - strangely"
msgstr "الحزمة %s لديها بيانات hsearch فارغة - وهذا غريب"

msgid "removing all entries with invalid multi-byte character data"
msgstr "جارٍ إزالة جميع المدخلات التي تحتوي على بيانات محارف متعددة البايت غير صالحة"

msgid "invalid browser name, check options(\"browser\")."
msgstr "اسم المتصفح غير صالح، تحقق من options(\"browser\")."

msgid "help.start() requires the HTTP server to be running"
msgstr "يتطلب help.start() أن يكون خادم HTTP قيد التشغيل"

msgid ""
"If nothing happens, you should open\n"
"%s yourself"
msgstr ""
"إذا لم يحدث شيء، فينبغي أن تفتح\n"
"%s بنفسك"

msgid "If the browser launched by '%s' is already running, it is *not* restarted, and you must switch to its window."
msgstr ""

msgid "Otherwise, be patient ..."
msgstr "وإلا فتحلَّ بالصبر ..."

msgid "'%s' must be a non-empty character string"
msgstr "يجب أن يكون '%s' سلسلة نصية غير فارغة"

msgid "no package '%s' was found"
msgstr "لم يتم العثور على حزمة '%s'"

msgid "metadata of package '%s' is corrupt"
msgstr "البيانات الوصفية للحزمة '%s' تالفة"

msgid "DESCRIPTION file of package '%s' is corrupt"
msgstr "ملف DESCRIPTION للحزمة '%s' تالف"

msgid "'DESCRIPTION' file has an 'Encoding' field and re-encoding is not possible"
msgstr "ملف 'DESCRIPTION' يحتوي على حقل 'Encoding' ولا يمكن إعادة الترميز"

msgid "DESCRIPTION file of package '%s' is missing or broken"
msgstr "ملف DESCRIPTION للحزمة '%s' مفقود أو معطوب"

msgid "Invalid \"Built\":"
msgstr "قيمة \"Built\" غير صالحة:"

msgid "Built: value is not a string"
msgstr "Built: القيمة ليست سلسلة نصية"

msgid "unable to create temporary directory %s"
msgstr "تعذّر إنشاء الدليل المؤقت %s"

msgid "file %s is not a binary package"
msgstr "الملف %s ليس حزمة ثنائية"

msgid "binary package %s is not compatible with this build of R"
msgstr "الحزمة الثنائية %s غير متوافقة مع هذا البناء من R"

msgid "package %s successfully unpacked and %s sums checked"
msgstr "تم فك حزمة %s بنجاح وفُحصت مجاميع %s"

msgid "package %s signature verified (%s %s)"
msgstr "تم التحقق من توقيع الحزمة %s ‏(%s %s)"

msgid "Valid signature is required, but package %s could not be successfully verified."
msgstr "التوقيع الصالح مطلوب، ولكن تعذّر التحقق من الحزمة %s بنجاح."

msgid ""
"ERROR: failed to lock directory %s for modifying\n"
"Try removing %s"
msgstr ""
"خطأ: فشل قفل الدليل %s للتعديل\n"
"جرّب إزالة %s"

msgid "ERROR: failed to create lock directory %s"
msgstr "خطأ: فشل إنشاء دليل القفل %s"

msgid "restored %s"
msgstr "تمت استعادة %s"

msgid "unable to move temporary installation %s to %s"
msgstr "تعذّر نقل التثبيت المؤقت %s إلى %s"

msgid "cannot remove prior installation of package %s"
msgstr "لا يمكن إزالة التثبيت السابق للحزمة %s"

msgid ""
"The downloaded binary packages are in\n"
"\t%s"
msgstr ""
"الحزم الثنائية التي تم تنزيلها موجودة في\n"
"\t%s"

msgid "cannot update HTML package index"
msgstr "لا يمكن تحديث فهرس حزم HTML"

msgid "done"
msgstr "منجز"

msgid "Source must be a seekable connection"
msgstr "يجب أن يكون المصدر اتصالًا قابلًا للبحث"

msgid "menu() cannot be used non-interactively"
msgstr "لا يمكن استخدام menu() بشكل غير تفاعلي"

msgid "Enter an item from the menu, or 0 to exit"
