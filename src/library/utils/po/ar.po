#, c-format
msgid "invalid '%s' argument"
msgstr "الوسيطة '%s' غير صالحة"

msgid "invalid quote symbol set"
msgstr "مجموعة رموز اقتباس غير صالحة"

msgid "cannot open the connection"
msgstr "لا يمكن فتح الاتصال"

msgid "cannot read from this connection"
msgstr "لا يمكن القراءة من هذا الاتصال"

#, c-format
msgid "quoted string on line %d terminated by EOF"
msgstr "سلسلة مقتبسة على السطر %d تم إنهاؤها بواسطة EOF"

msgid "the first argument must be of mode character"
msgstr "يجب أن تكون الوسيطة الأولى ذات طابع الوضع"

#, c-format
msgid "invalid 'numerals' string: \"%s\""
msgstr "سلسلة \"أرقام\" غير صالحة: \"%s\""

#, c-format
msgid "Selection: "
msgstr "إنتخاب: "

msgid "cannot allocate buffer in 'readTableHead'"
msgstr "لا يمكن تخصيص المخزن المؤقت في \"readTableHead\""

msgid "\\ followed by EOF"
msgstr "\\ يليه EOF"

#, c-format
msgid "incomplete final line found by readTableHeader on '%s'"
msgstr "تم العثور على السطر النهائي غير المكتمل بواسطة readTableHeader على \"%s\""

msgid "index out of range"
msgstr "مؤشر خارج النطاق"

#, c-format
msgid "Problem closing connection:  %s"
msgstr "مشكلة إغلاق الاتصال:%s"

msgid "Problem closing connection"
msgstr "مشكلة إغلاق الاتصال"

msgid "'file' is not a connection"
msgstr "\"الملف\" ليس اتصالا"

msgid "cannot write to this connection"
msgstr "لا يمكن الكتابة إلى هذا الاتصال"

msgid "'dec' must be a single character"
msgstr "يجب أن يكون \"dec\" حرفا واحدا"

#, c-format
msgid "corrupt data frame -- length of column %d does not match nrows"
msgstr "إطار البيانات التالف - طول العمود %d لا يتطابق مع الصفوف"

#, c-format
msgid "column %d claims to be a factor but does not have numeric codes"
msgstr "يدعي العمود %d أنه عامل ولكن لا يحتوي على رموز رقمية"

msgid "corrupt matrix -- dims do not match length"
msgstr "مصفوفة تالفة - لا تتطابق الطول مع DIMS"

msgid "'savehistory' can only be used in Rgui and Rterm"
msgstr "لا يمكن استخدام \"حفظ التاريخ\" إلا في Rgui و Rterm"

msgid "'loadhistory' can only be used in Rgui and Rterm"
msgstr "لا يمكن استخدام \"حفظ التاريخ\" إلا في Rgui و Rterm"

msgid "invalid timestamp"
msgstr "طابع زمني غير صالح"

msgid "X11 dataentry cannot be loaded"
msgstr "لا يمكن تحميل إدخال بيانات X11"

msgid "X11 is not available"
msgstr "X11 غير متوفر"

#, c-format
msgid "invalid '%s' specification"
msgstr "مواصفات \"%s\" غير صالحة"

#, c-format
msgid "'%s' contains missing values"
msgstr "يحتوي \"%s\" على قيم مفقودة"

msgid "argument 'class' must be a character string"
msgstr "يجب أن تكون الوسيطة \"class\" سلسلة أحرف"

msgid "argument 'x' must be a length-1 character vector"
msgstr "يجب أن تكون الوسيطة \"X\" متجه بطول 1 حرف"

msgid "argument 'x' must be UTF-8 encoded (including ASCII)"
msgstr "يجب أن تكون الوسيطة \"x\" مشفرة ب UTF-8 (بما في ذلك ASCII)"

msgid "'hostname' must be a character vector of length 1"
msgstr "يجب أن يكون \"اسم المضيف\" متجه حرف بطول 1"

#, c-format
msgid "nsl() was unable to resolve host '%s'"
msgstr "تعذر على nsl() حل المضيف \"%s\""

msgid "unknown format returned by 'gethostbyname'"
msgstr "تنسيق غير معروف تم إرجاعه بواسطة \"gethostbyname\""

msgid "nsl() is not supported on this platform"
msgstr "NSL() غير مدعوم على هذه المنصة"

msgid "unknown type"
msgstr "نوع غير معروف"

msgid "menu functions can only be used in the GUI"
msgstr "لا يمكن استخدام وظائف القائمة إلا في واجهة المستخدم الرسومية (GUI)"

#, c-format
msgid "unable to retrieve items for %s (%s)"
msgstr "يتعذر استرداد العناصر ل %s (%s)"

#, c-format
msgid "unable to add menu (%s)"
msgstr "تعذر إضافة القائمة (%s)"

#, c-format
msgid "unable to add menu item (%s)"
msgstr "تعذر إضافة القائمة (%s)"

msgid "menu does not exist"
msgstr "القائمة غير موجودة"

#, c-format
msgid "unable to delete menu item (%s)"
msgstr "تعذر إضافة القائمة (%s)"

#, c-format
msgid "invalid '%s' value"
msgstr "قيمة \"%s\" غير صالحة"

#, c-format
msgid "Registry key '%ls' not found"
msgstr "لم يتم العثور على مفتاح التسجيل \"%ls\""

msgid "unsupported version of Windows"
msgstr "إصدار غير مدعوم من Windows"

msgid "argument must be a character vector or a raw vector"
msgstr "يجب أن تكون الوسيطة متجه حرف أو متجه أولي"

msgid "unable to open the clipboard"
msgstr "تعذر فتح الحافظة"

msgid "unable to write to the clipboard"
msgstr "تعذر فتح الحافظة"

msgid "'title' must be a character string"
msgstr "يجب أن يكون \"العنوان\" سلسلة أحرف"

msgid "'text' must be a character string"
msgstr "يجب أن يكون \"النص\" عبارة عن سلسلة أحرف"

#, c-format
msgid "'%s' must be length 1"
msgstr "يجب أن يكون طول \"%s\" 1"

#, c-format
msgid "'%s' must be a list"
msgstr "يجب أن تكون \"%s\" قائمة"

#, c-format
msgid "'%s' element %d is not a window handle"
msgstr "عنصر \"%s\" %d ليس مقبض نافذة"

msgid "Select one or more"
msgstr "حدد واحدا أو أكثر"

msgid "Select one"
msgstr "حدد واحدا"

msgid "'default' must be a character string"
msgstr "يجب أن تكون كلمة \"default\" عبارة عن سلسلة أحرف"

msgid "'default' is overlong"
msgstr "\"الافتراضي\" طويل الأمد"

msgid "'caption' must be a character string"
msgstr "يجب أن يكون \"النص\" عبارة عن سلسلة أحرف"

msgid "'multi' must be a logical value"
msgstr "يجب أن تكون كلمة \"متعددة\" قيمة منطقية"

msgid "'filterindex' must be an integer value"
msgstr "يجب أن يكون \"filterindex\" قيمة صحيحة"
