#, c-format
msgid "invalid '%s' argument"
msgstr "неправильный аргумент '%s'"

msgid "invalid quote symbol set"
msgstr "неправильная установка символа кавычек"

msgid "cannot open the connection"
msgstr "не могу открыть соединение"

msgid "cannot read from this connection"
msgstr "не могу прочитать из соединения"

#, c-format
msgid "quoted string on line %d terminated by EOF"
msgstr "закавыченная подстрока строки %d заканчивается EOF"

msgid "the first argument must be of mode character"
msgstr "первый аргумент должен быть текстовым"

#, c-format
msgid "invalid 'numerals' string: \"%s\""
msgstr "неправильная строка 'numerals': \"%s\""

#, c-format
msgid "Selection: "
msgstr "Выбор: "

msgid "cannot allocate buffer in 'readTableHead'"
msgstr "не могу разместить буфер в 'readTableHead'"

msgid "\\ followed by EOF"
msgstr "за \\ следует EOF"

#, c-format
msgid "incomplete final line found by readTableHeader on '%s'"
msgstr "readTableHeader нашел неполную последнюю строку в '%s'"

msgid "index out of range"
msgstr "индекс вне пределов"

#, c-format
msgid "Problem closing connection:  %s"
msgstr "Проблема с закрытием соединения: %s"

msgid "Problem closing connection"
msgstr "Проблема с закрытием соединения"

msgid "'file' is not a connection"
msgstr "'file' -- это не соединение"

msgid "cannot write to this connection"
msgstr "не могу писать в это соединение"

msgid "'dec' must be a single character"
msgstr "'dec' должен быть одним символом"

#, c-format
msgid "corrupt data frame -- length of column %d does not match nrows"
msgstr "поврежденная таблица данных -- длина колонки %d не соответствует строкам"

#, c-format
msgid "column %d claims to be a factor but does not have numeric codes"
msgstr "колонка %d считает себя фактором, но у нее нет числовых кодов"

msgid "corrupt matrix -- dims do not match length"
msgstr "поврежденная матрица -- длины измерений не сходятся"

msgid "'savehistory' can only be used in Rgui and Rterm"
msgstr "'savehistory' можно использовать только в Rgui и Rterm"

msgid "'loadhistory' can only be used in Rgui and Rterm"
msgstr "'loadhistory' можно использовать только Rgui и Rterm"

msgid "invalid timestamp"
msgstr "неправильная дата и время"

msgid "X11 dataentry cannot be loaded"
msgstr "таблицу X11 нельзя загрузить"

msgid "X11 is not available"
msgstr "X11 недоступна"

#, c-format
msgid "invalid '%s' specification"
msgstr "неправильное определение '%s'"

#, c-format
msgid "'%s' contains missing values"
msgstr "'%s' содержит пропущенные значения"

msgid "argument 'class' must be a character string"
msgstr "аргумент 'class' должен быть текстовой строкой"

msgid "argument 'x' must be a length-1 character vector"
msgstr "аргумент 'x' должен быть текстовой строкой"

msgid "argument 'x' must be UTF-8 encoded (including ASCII)"
msgstr "аргумент 'x' должен быть в UTF-8 (включая ASCII)"

msgid "'hostname' must be a character vector of length 1"
msgstr "'hostname' должно быть текстовым вектором длиной 1"

#, c-format
msgid "nsl() was unable to resolve host '%s'"
msgstr "nsl() не смог разрешить хост '%s'"

msgid "unknown format returned by 'gethostbyname'"
msgstr "'gethostbyname' вернула неправильный формат"

msgid "nsl() is not supported on this platform"
msgstr "nsl() не поддерживается на этой платформе"

msgid "unknown type"
msgstr "неизвестный тип"

msgid "menu functions can only be used in the GUI"
msgstr "функции меню можно использовать только в GUI"

#, c-format
msgid "unable to retrieve items for %s (%s)"
msgstr "не могу получить элементы для %s (%s)"

#, c-format
msgid "unable to add menu (%s)"
msgstr "не могу добавить меню (%s)"

#, c-format
msgid "unable to add menu item (%s)"
msgstr "не могу добавить элемент меню (%s)"

msgid "menu does not exist"
msgstr "меню не существует"

#, c-format
msgid "unable to delete menu item (%s)"
msgstr "не могу удалить элемент меню (%s)"

#, c-format
msgid "invalid '%s' value"
msgstr "неправильное значение '%s'"

#, c-format
msgid "Registry key '%ls' not found"
msgstr "Ключ реестра '%ls' не найден"

msgid "unsupported version of Windows"
msgstr "неподдерживаемая версия Windows"

msgid "argument must be a character vector or a raw vector"
msgstr "аргумент должен быть текстовым вектором или простым вектором"

msgid "unable to open the clipboard"
msgstr "не могу открыть буфер обмена"

msgid "unable to write to the clipboard"
msgstr "не могу писать в буфер обмена"

msgid "'title' must be a character string"
msgstr "'title' должен быть текстовой строкой"

msgid "'text' must be a character string"
msgstr "'text' должен быть текстовой строкой"

#, c-format
msgid "'%s' must be length 1"
msgstr "'%s' должен быть длиной 1"

#, c-format
msgid "'%s' must be a list"
msgstr "'%s' должен быть списком"

#, c-format
msgid "'%s' element %d is not a window handle"
msgstr "'%s' элемент из %d -- не дескриптор окна"

msgid "Select one or more"
msgstr "Выберите один или больше"

msgid "Select one"
msgstr "Выберите один"

msgid "'default' must be a character string"
msgstr "'default' должен быть текстовой строкой"

msgid "'default' is overlong"
msgstr "'default' слишком длинный"

msgid "'caption' must be a character string"
msgstr "'caption' должен быть текстовой строкой"

msgid "'multi' must be a logical value"
msgstr "'multi' должен быть логическим"

msgid "'filterindex' must be an integer value"
msgstr "'filterindex' должен быть целочисленным"
