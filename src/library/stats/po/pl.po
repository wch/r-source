#, c-format
msgid "Hessian function must return a square numeric matrix of order %d"
msgstr "Funkcja hesjanu musi zwrócić kwadratową macierz liczbową rzędu %d"

msgid "'rho' must be an environment"
msgstr "'rho' musi być środowiskiem"

msgid "'d' must be a nonempty numeric (double) vector"
msgstr "'d' musi być niepustym wektorem liczbowym (rzeczywistym)"

msgid "When Hessian defined must also have gradient defined"
msgstr "Kiedy Hesjan jest zdefiniowany gradient musi również być zdefiniowany"

#, c-format
msgid "environment 'rho' must contain a numeric (double) vector '.par' of length %d"
msgstr "środowisko 'rho' musi zawierać (rzeczywisty) wektor liczbowy '.par' o długości %d"

msgid "'lower' and 'upper' must be numeric (double) vectors"
msgstr "'lower' oraz 'upper' muszą być (rzeczywistymi) wektorami liczbowymi"

msgid "'getElement' applies only to named lists"
msgstr "'getElement' stosuje się jedynie do nazwanych list"

#, c-format
msgid "%s$%s() not found"
msgstr "'%s$%s()' nie zostało znalezione"

#, c-format
msgid "'gradient' must be a numeric matrix of dimension (%d,%d)"
msgstr "'gradient' musi być macierzą liczbową o wymiarze (%d,%d)"

#, c-format
msgid "fcn produced mode %d, length %d - wanted mode %d, length %d"
msgstr "'fcn' wyprodukował tryb %d, długość %d - oczekiwano tryb %d, długość %d"

msgid "invalid type for eval_check_store"
msgstr "niepoprawny typ dla funkcji 'eval_check_store()'"

msgid "m must be a list"
msgstr "argument 'm' musi być listą"

msgid "'lowerb' and 'upperb' must be numeric vectors"
msgstr "'lowerb' oraz 'upperb' muszą być wektorami liczbowymi"

msgid "invalid sample size 'n' in C routine prho(n,s,*)"
msgstr "nieprawidłowy rozmiar 'n' próby w procedurze C 'prho(n,s,*)'"

msgid "inconsistent degrees of freedom and dimension"
msgstr "niespójna liczba stopni swobody oraz wymiaru"

msgid "'scal' must be a square, real matrix"
msgstr "'scal' musi być kwadratową, rzeczywistą macierzą"

msgid "'scal' matrix is not positive-definite"
msgstr "macierz 'scal' nie jest dodatnio określona"

msgid "NAs produced"
msgstr "wyprodukowano wartości NA"

msgid "invalid arguments"
msgstr "niepoprawne argumenty"

msgid "NA in probability vector"
msgstr "wartość NA w wektorze prawdopodobieństwa"

msgid "negative probability"
msgstr "ujemne prawdopodobieństwo"

msgid "no positive probabilities"
msgstr "brak dodatnich prawdopodobieństw"

msgid "invalid first argument 'n'"
msgstr "niepoprawny pierwszy argument 'n'"

msgid "invalid second argument 'size'"
msgstr "niepoprawny drugi argument 'size'"

#, c-format
msgid "rcont2 [%d,%d]: exp underflow to 0; algorithm failure"
msgstr "rcont2 [%d,%d]: wyrażenie spadło do 0; niepowodzenie algorytmu"

#, c-format
msgid "invalid end-rule for running median of 3: %d"
msgstr "niepoprawna końcowa reguła dla ruchomej mediany 3: %d"

#, c-format
msgid "missing value in last %d observations"
msgstr "brakuje wartości w ostatnich %d obserwacjach"

