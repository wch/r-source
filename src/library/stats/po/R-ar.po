msgid "models are not all fitted to the same number of observations"
msgstr "لا يتم تركيب جميع النماذج على نفس العدد من الملاحظات"

msgid "empty model supplied"
msgstr "المودل المزود فارغ"

msgid "'acf' must be of length two or more"
msgstr "يجب أن يكون طول 'acf' اثنين أو أكثر"

msgid "object not interpretable as a factor"
msgstr "لا يمكن تفسير الكائن على أنه عامل"

msgid "cannot fit models without level ('alpha' must not be 0 or FALSE)"
msgstr "لا يمكن ملاءمة النماذج دون مستوى ('alpha' يجب ألا يكون 0 أو FALSE)"

msgid "'alpha', 'beta' and 'gamma' must be within the unit interval"
msgstr "يجب أن تكون 'alpha' و'beta' و'gamma' ضمن فاصل الوحدة"

msgid "data must be non-zero for multiplicative Holt-Winters"
msgstr "يجب ألا تكون البيانات صفرية في Holt-Winters الضربي"

msgid "need at least 2 periods to compute seasonal start values"
msgstr "يلزم وجود فترتين على الأقل لحساب قيم البدء الموسمية"

msgid "invalid length(x)"
msgstr "length(x) غير صالح"

msgid "optimization difficulties: %s"
msgstr "صعوبات التحسين: %s"

msgid "optimization failure"
msgstr "فشل التحسين"

msgid "time series has no or less than 2 periods"
msgstr "السلاسل الزمنية لا تحتوي على فترات أو أقل من 2 فترات"

msgid "the series is entirely NA"
msgstr "series هو بالكامل NA"

msgid "frequency must be a positive integer >= 2 for BSM"
msgstr "يجب أن يكون التردد عددا صحيحا موجبا > = 2 ل BSM"

msgid "only implemented for univariate time series"
msgstr "يتم تنفيذها فقط للسلاسل الزمنية أحادية المتغير"

msgid "'x' must be numeric"
msgstr "يجب أن يكون \"x\" رقميا"

msgid "the first value of the time series must not be missing"
msgstr "يجب ألا تكون القيمة الأولى للسلسلة الزمنية مفقودة"

msgid "all parameters were fixed"
msgstr "تم تثبيت جميع المعاملات"

msgid "possible convergence problem: 'optim' gave code = %d and message %s"
msgstr "مشكلة تقارب محتملة: أعطت 'optim' الرمز = %d والرسالة %s"

msgid "no factors in the fitted model"
msgstr "لا توجد عوامل في النموذج الملائم"

msgid "'which' specified no factors"
msgstr "لم يحدد 'which' أي عوامل"

msgid "'which' specified some non-factors which will be dropped"
msgstr "حدد 'which' بعض العناصر غير العاملية التي سيتم إسقاطها"

msgid "'sampleT' and 'nser' must be integer"
msgstr "يجب أن يكون 'sampleT' و'nser' عددين صحيحين"

msgid "'lag.max' must be at least 0"
msgstr "يجب أن يكون 'lag.max' على الأقل 0"

msgid "'lag.max' must be at least 1"
msgstr "يجب أن يكون 'lag.max' على الأقل 1"

msgid "NAs in 'x'"
msgstr "توجد قيم NA في 'x'"

msgid "x$lag must have at least 1 column"
msgstr "يجب أن يحتوي x$lag على عمود واحد على الأقل"

msgid "can use ci.type=\"ma\" only if first lag is 0"
msgstr "يمكن استخدام ci.type=\"ma\" فقط إذا كان التأخر الأول 0"

msgid "Page [%d,%d]: i =%s; j =%s"
msgstr "الصفحة [%d,%d]: i =%s؛ j =%s"

msgid "univariate time series only"
msgstr "سلاسل زمنية أحادية المتغير فقط"

msgid "no terms in scope"
msgstr "لا توجد حدود في النطاق"

msgid "no terms in scope for adding to object"
msgstr "لا توجد حدود في النطاق لإضافتها إلى الكائن"

msgid "number of rows in use has changed: remove missing values?"
msgstr "تغير عدد الصفوف المستخدمة: هل تريد إزالة القيم المفقودة؟"

msgid "attempting model selection on an essentially perfect fit is nonsense"
msgstr "محاولة اختيار النموذج مع ملاءمة شبه مثالية لا معنى لها"

msgid "F test assumes quasi%s family"
msgstr "يفترض اختبار F عائلة quasi%s"

msgid "no 'add1' method implemented for \"mlm\" models"
msgstr "لا توجد طريقة 'add1' منفّذة لنماذج \"mlm\""

msgid "scope is not a subset of term labels"
msgstr "النطاق ليس مجموعة جزئية من تسميات الحدود"

msgid "no 'drop1' method for \"mlm\" models"
msgstr "لا توجد طريقة 'drop1' لنماذج \"mlm\""

msgid "F test assumes 'quasi%s' family"
msgstr "يفترض اختبار F عائلة 'quasi%s'"

msgid "AIC is not defined for this model, so 'step' cannot proceed"
msgstr "AIC غير معرّف لهذا النموذج، لذلك لا يمكن لـ 'step' المتابعة"

msgid "AIC is -infinity for this model, so 'step' cannot proceed"
msgstr "AIC يساوي -infinity لهذا النموذج، لذلك لا يمكن لـ 'step' المتابعة"

msgid "'A' must be an array or table"
msgstr "يجب أن يكون 'A' مصفوفة متعددة الأبعاد أو جدولًا"

msgid ""
"length of FUN, %d,\n"
" does not match the length of the margins, %d"
msgstr ""
"طول FUN، %d،\n"
" لا يطابق طول الهوامش، %d"

msgid "no rows to aggregate"
msgstr "لا توجد صفوف لتجميعها"

msgid "'by' must be a list"
msgstr "يجب أن يكون 'by' قائمة"

msgid "arguments must have same length"
msgstr "يجب أن تكون الوسائط بالطول نفسه"

msgid "argument 'x' is  missing -- it has been renamed from 'formula'"
msgstr "الوسيط 'x' مفقود -- تمت إعادة تسميته من 'formula'"

msgid "argument 'x' must be a formula"
msgstr "يجب أن يكون الوسيط 'x' صيغة"

msgid "formula 'x' must have both left and right hand sides"
msgstr "يجب أن تحتوي الصيغة 'x' على طرفين أيسر وأيمن"

msgid "cannot change frequency from %g to %g"
msgstr "لا يمكن تغيير التردد من %g إلى %g"

msgid "'x' must be coefficient matrix/data frame"
msgstr "يجب أن يكون 'x' مصفوفة معاملات/إطار بيانات"

msgid "option \"show.coef.Pvalues\" is invalid: assuming TRUE"
msgstr "الخيار \"show.coef.Pvalues\" غير صالح: سيتم افتراض TRUE"

msgid "'P.values' is TRUE, but 'has.Pvalue' is not"
msgstr "'P.values' يساوي TRUE، لكن 'has.Pvalue' ليس كذلك"

msgid "wrong k / cs.ind"
msgstr "k / cs.ind غير صحيح"

msgid "option \"show.signif.stars\" is invalid: assuming TRUE"
msgstr "الخيار \"show.signif.stars\" غير صالح: سيتم افتراض TRUE"

msgid "'anova' object must have colnames"
msgstr "يجب أن يحتوي كائن 'anova' على colnames"

msgid "'conf.level' must be a single number between 0 and 1"
msgstr "يجب أن يكون 'conf.level' عددًا واحدًا بين 0 و1"

msgid "not enough 'x' observations"
msgstr "لا توجد ملاحظات 'x' كافية"

msgid "not enough 'y' observations"
msgstr "لا توجد ملاحظات 'y' كافية"

msgid "samples differ in location: cannot compute confidence set, returning NA"
msgstr "تختلف العينات في الموقع: لا يمكن حساب مجموعة الثقة، سيتم إرجاع NA"

msgid "cannot compute confidence set, returning NA"
msgstr "لا يمكن حساب مجموعة الثقة، سيتم إرجاع NA"

msgid "cannot compute asymptotic confidence set or estimator"
msgstr "لا يمكن حساب مجموعة الثقة أو المقدّر التقاربي"

msgid "cannot compute estimate, returning NA"
msgstr "لا يمكن حساب التقدير، سيتم إرجاع NA"

msgid "cannot compute exact p-value with ties"
msgstr "لا يمكن حساب قيمة p الدقيقة مع وجود قيم متعادلة"

msgid "cannot compute exact confidence interval with ties"
msgstr "لا يمكن حساب فاصل الثقة الدقيق مع وجود قيم متعادلة"

msgid "'formula' missing or incorrect"
msgstr "'formula' مفقودة أو غير صحيحة"

msgid "grouping factor must have exactly 2 levels"
msgstr "يجب أن يكون لعامل التجميع مستويان بالضبط"

msgid "weights are not supported in a multistratum aov() fit"
msgstr "الأوزان غير مدعومة في ملاءمة aov() متعددة الطبقات"

msgid "Error() model is singular"
msgstr "نموذج Error() مفرد"

msgid "the 'split' argument must be a list"
msgstr "يجب أن يكون الوسيط 'split' قائمة"

msgid "'coef' must define a contrast, i.e., sum to 0"
msgstr "يجب أن يعرّف 'coef' تباينًا، أي أن يكون مجموعه 0"

msgid "'coef' must have same length as 'contrast.obj'"
msgstr "يجب أن يكون 'coef' بالطول نفسه مثل 'contrast.obj'"

msgid "each element of '%s' must be logical"
msgstr "يجب أن يكون كل عنصر من '%s' منطقيًا"

msgid "the contrast defined is empty (has no TRUE elements)"
msgstr "التباين المعرّف فارغ (لا يحتوي على عناصر TRUE)"

msgid "columns of 'contrast.obj' must define a contrast (sum to zero)"
msgstr "يجب أن تعرّف أعمدة 'contrast.obj' تباينًا (مجموعها صفر)"

msgid "no degrees of freedom for residuals"
msgstr "لا توجد درجات حرية للبواقي"

msgid "'object' does not include an error 'qr' component"
msgstr "لا يتضمن 'object' مكوّن خطأ 'qr'"

msgid "Refitting model to allow projection"
msgstr "إعادة ملاءمة النموذج للسماح بالإسقاط"

msgid "columns of 'contrast.obj' must define a contrast(sum to zero)"
msgstr "يجب أن تعرّف أعمدة 'contrast.obj' تباينًا (مجموعها صفر)"

msgid "'ties' is not \"ordered\", a function, or list(<string>, <function>)"
msgstr "'ties' ليس \"ordered\" ولا دالة ولا list(<string>, <function>)"

msgid "collapsing to unique 'x' values"
msgstr "سيتم الاختزال إلى قيم 'x' الفريدة"

msgid "invalid interpolation method"
msgstr "طريقة الاستيفاء غير صالحة"

msgid "need at least two non-NA values to interpolate"
msgstr "يلزم وجود قيمتين غير NA على الأقل للاستيفاء"

msgid "zero non-NA points"
msgstr "لا توجد نقاط غير NA"

msgid "'approx' requires n >= 1"
msgstr "تتطلب 'approx' أن يكون n >= 1"

msgid "NAs in 'x' must be the same row-wise"
msgstr "يجب أن تكون قيم NA في 'x' متطابقة على مستوى الصفوف"

msgid "'order.max' must be >= 1"
msgstr "يجب أن يكون 'order.max' >= 1"

msgid "'order.max' must be < 'n.obs'"
msgstr "يجب أن يكون 'order.max' < 'n.obs'"

msgid "zero-variance series"
msgstr "سلسلة ذات تباين صفري"

msgid "'n.ahead' must be at least 1"
msgstr "يجب أن يكون 'n.ahead' على الأقل 1"

msgid "number of series in 'object' and 'newdata' do not match"
msgstr "عدد السلاسل في 'object' و'newdata' غير متطابق"

msgid "'se.fit' not yet implemented for multivariate models"
msgstr "لم يتم تنفيذ 'se.fit' بعد للنماذج متعددة المتغيرات"

msgid "MLE only implemented for univariate series"
msgstr "تم تنفيذ MLE فقط للسلاسل أحادية المتغير"

msgid "'order.max' must be >= 0"
msgstr "يجب أن يكون 'order.max' >= 0"

msgid "'order.max' must be < 'n.used'"
msgstr "يجب أن يكون 'order.max' < 'n.used'"

msgid "'order' must be a non-negative numeric vector of length 3"
msgstr "يجب أن يكون 'order' متجهًا رقميًا غير سالب بطول 3"

msgid "'seasonal' must be a list with component 'order'"
msgstr "يجب أن يكون 'seasonal' قائمة تحتوي على المكوّن 'order'"

msgid "'seasonal$order' must be a non-negative numeric vector of length 3"
msgstr "يجب أن يكون 'seasonal$order' متجهًا رقميًا غير سالب بطول 3"

msgid "if not a list, 'seasonal' must be a non-negative numeric vector of length 3"
msgstr "إذا لم يكن 'seasonal' قائمة، فيجب أن يكون متجهًا رقميًا غير سالب بطول 3"

msgid "'seasonal' is neither a list with component 'order' nor a numeric vector of length 3"
msgstr "'seasonal' ليس قائمة تحتوي على المكوّن 'order' ولا متجهًا رقميًا بطول 3"

msgid "lengths of 'x' and 'xreg' do not match"
msgstr "طولا 'x' و'xreg' غير متطابقين"

msgid "wrong length for 'fixed'"
msgstr "طول 'fixed' غير صحيح"

msgid "some AR parameters were fixed: setting transform.pars = FALSE"
msgstr "تم تثبيت بعض معاملات AR: سيتم تعيين transform.pars = FALSE"

msgid "too few non-missing observations"
msgstr "عدد الملاحظات غير المفقودة قليل جدًا"

msgid "'init' is of the wrong length"
msgstr "'init' بطول غير صحيح"

msgid "non-stationary AR part"
msgstr "جزء AR غير مستقر"

msgid "non-stationary seasonal AR part"
msgstr "جزء AR الموسمي غير مستقر"

msgid "possible convergence problem: optim gave code = %d"
msgstr "مشكلة تقارب محتملة: أعطت optim الرمز = %d"

msgid "non-stationary AR part from CSS"
msgstr "جزء AR غير مستقر من CSS"

msgid "non-stationary seasonal AR part from CSS"
msgstr "جزء AR الموسمي غير مستقر من CSS"

msgid "'xreg' and 'newxreg' have different numbers of columns"
msgstr "لدى 'xreg' و'newxreg' عدد مختلف من الأعمدة"

msgid "MA part of model is not invertible"
msgstr "جزء MA من النموذج غير قابل للعكس"

msgid "seasonal MA part of model is not invertible"
msgstr "جزء MA الموسمي من النموذج غير قابل للعكس"

msgid "NAs in '%s'"
msgstr "توجد قيم NA في '%s'"

msgid "invalid 'SSinit'"
msgstr "'SSinit' غير صالح"

msgid "converting non-invertible initial MA values"
msgstr "تحويل قيم MA الابتدائية غير القابلة للعكس"

msgid "some ARMA parameters were fixed: setting transform.pars = FALSE"
msgstr "تم تثبيت بعض معاملات ARMA: سيتم تعيين transform.pars = FALSE"

msgid "'xreg' is collinear"
msgstr "'xreg' مترافق خطيًا"

msgid "NAs present: setting 'delta' to -1"
msgstr "توجد قيم NA: سيتم تعيين 'delta' إلى -1"

msgid "transformed ARMA parameters were fixed"
msgstr "تم تثبيت معاملات ARMA المحوّلة"

msgid "need at least 2 data points"
msgstr "يلزم على الأقل 2 نقاط بيانات"

msgid "invalid 'x'"
msgstr "'x' غير صالح"

msgid "invalid 'nb'"
msgstr "'nb' غير صالح"

msgid "no solution in the specified range of bandwidths"
msgstr "لا يوجد حل في النطاق المحدد لـ bandwidths"

msgid "increasing bw.SJ() search interval (%d) to [%.4g,%.4g]"
msgstr "زيادة bw.SJ() فاصل البحث (%d) إلى [%.4g,%.4g]"

msgid "minimum occurred at one end of the range"
msgstr "حدث الحد الأدنى عند أحد طرفي النطاق"

msgid "'x' must be a list with at least 2 elements"
msgstr "يجب أن يكون 'x' قائمة مع ما لا يقل عن 2 العناصر"

msgid "'x' and 'g' must have the same length"
msgstr "'x' و 'g' يجب أن يحتوي الطول نفسه"

msgid "all observations are in the same group"
msgstr "جميع الملاحظات هي في المجموعة نفسها"

msgid "there must be at least 2 observations in each group"
msgstr "there يجب أن يكون على الأقل 2 الملاحظات في each مجموعة"

msgid "'formula' should be of the form response ~ group"
msgstr "'formula' ينبغي أن يكون لـ form استجابة ~ مجموعة"

msgid "'x' must be nonnegative and integer"
msgstr "يجب أن يكون 'x' غير سالبة و عدد صحيح"

msgid "'n' must be a positive integer >= 'x'"
msgstr "يجب أن يكون 'n' عددًا صحيحًا موجبًا >= 'x'"

msgid "incorrect length of 'x'"
msgstr "طول غير صحيح لـ 'x'"

msgid "'p' must be a single number between 0 and 1"
msgstr "يجب أن يكون 'p' عددًا واحدًا بين 0 و 1"

msgid "length of choices must be 2"
msgstr "length لـ الخيارات يجب أن يكون 2"

msgid "object '%s' has no scores"
msgstr "كائن '%s' لا يحتوي على الدرجات"

msgid "'scale' is outside [0, 1]"
msgstr "'scale' هو خارج [0, 1]"

msgid "biplots are not defined for complex PCA"
msgstr "الرسوم الثنائية ليست defined لـ PCA المركب"

msgid "unequal number of rows in 'cancor'"
msgstr "عدد غير متساوٍ من الصفوف في 'cancor'"

msgid "dimension 0 in 'x' or 'y'"
msgstr "البُعد 0 في 'x' أو 'y'"

msgid "'x' has rank 0"
msgstr "'x' رتبته 0"

msgid "'y' has rank 0"
msgstr "'y' رتبته 0"

msgid "'x' and 'y' must have the same length"
msgstr "'x' و 'y' يجب أن يحتوي الطول نفسه"

msgid "'x' and 'y' must have at least 2 levels"
msgstr "يجب أن يحتوي 'x' و 'y' على على الأقل 2 مستويات"

msgid "all entries of 'x' must be nonnegative and finite"
msgstr "جميع المدخلات لـ 'x' يجب أن يكون غير سالبة و منتهية"

msgid "at least one entry of 'x' must be positive"
msgstr "على الأقل one مدخل لـ 'x' يجب أن يكون موجب"

msgid "cannot compute simulated p-value with zero marginals"
msgstr "لا يمكن حساب محاكاة قيمة p مع مجاميع هامشية صفرية"

msgid "'x' must at least have 2 elements"
msgstr "'x' must على الأقل have 2 العناصر"

msgid "'x' and 'p' must have the same number of elements"
msgstr "'x' و 'p' يجب أن يحتوي العدد نفسه لـ العناصر"

msgid "probabilities must be non-negative."
msgstr "الاحتمالات يجب أن يكون غير سالب."

msgid "probabilities must sum to 1."
msgstr "الاحتمالات يجب أن يكون مجموعها 1."

msgid "Chi-squared approximation may be incorrect"
msgstr "Chi-squared تقريب قد يكون غير صحيح"

msgid "NA values not allowed in 'd'"
msgstr "NA القيم غير مسموح في 'd'"

msgid "eig=TRUE is disregarded when list.=FALSE"
msgstr "eig=TRUE هو تم تجاهله when قائمة.=FALSE"

msgid "x.ret=TRUE is disregarded when list.=FALSE"
msgstr "x.ret=TRUE هو تم تجاهله when قائمة.=FALSE"

msgid "distances must be result of 'dist' or a square matrix"
msgstr "المسافات يجب أن يكون النتيجة لـ 'dist' أو مربعة مصفوفة"

msgid "invalid value of %s"
msgstr "قيمة %s غير صالحة"

msgid "'k' must be in {1, 2, ..  n - 1}"
msgstr "يجب أن يكون 'k' في {1, 2, .. n - 1}"

msgid "only %d of the first %d eigenvalues are > 0"
msgstr "فقط %d لـ first %d القيم الذاتية هي > 0"

msgid "Waiting for profiling to be done..."
msgstr "بانتظار اكتمال التنميط..."

msgid "Reprofiling for"
msgstr "إعادة التنميط من أجل"

msgid "statistic. Waiting..."
msgstr "الإحصائية. بانتظار..."

msgid "initial value is not in the interior of the feasible region"
msgstr "القيمة الابتدائية ليس في داخل لـ المنطقة الممكنة"

msgid "Barrier algorithm ran out of iterations and did not converge"
msgstr "خوارزمية الحاجز استنفدت التكرارات و لم يتقارب"

msgid "Objective function increased at outer iteration %d"
msgstr "دالة الهدف زادت at التكرار الخارجي %d"

msgid "Objective function decreased at outer iteration %d"
msgstr "دالة الهدف انخفضت at التكرار الخارجي %d"

msgid "contrasts not defined for %d degrees of freedom"
msgstr "التباينات غير معرّف لـ %d درجات الحرية"

msgid "orthogonal polynomials cannot be represented accurately enough for %d degrees of freedom"
msgstr "كثيرات الحدود المتعامدة لا يمكن أن يكون تمثيلها بدقة كافية لـ %d درجات الحرية"

msgid "'scores' argument is of the wrong length"
msgstr "'scores' وسيط هو لـ طول غير صحيح"

msgid "'scores' must all be different numbers"
msgstr "'scores' must جميع يكون أعداد مختلفة"

msgid "'degree' must be at least 1"
msgstr "يجب أن يكون 'degree' على الأقل 1"

msgid "missing values are not allowed in 'poly'"
msgstr "مفقود القيم ليست مسموح في 'poly'"

msgid "'degree' must be less than number of unique points"
msgstr "يجب أن يكون 'degree' أقل من عدد unique points"

msgid "must supply one or more vectors"
msgstr "يجب تقديم واحدًا أو أكثر من vectors"

msgid "arguments must have the same length"
msgstr "وسائط يجب أن يحتوي الطول نفسه"

msgid "wrong number of columns in new data:"
msgstr "عدد غير صحيح لـ الأعمدة في البيانات الجديدة:"

msgid "contrasts apply only to factors"
msgstr "التباينات تنطبق فقط إلى factors"

msgid "contrasts can be applied only to factors with 2 or more levels"
msgstr "التباينات يمكن أن يكون طُبقت فقط إلى factors مع 2 أو more مستويات"

msgid "wrong number of contrast matrix rows"
msgstr "عدد غير صحيح لـ مصفوفة التباين الصفوف"

msgid "singular contrast matrix"
msgstr "مفرد مصفوفة التباين"

msgid "numeric contrasts or contrast name expected"
msgstr "رقمي التباينات أو تباين name متوقع"

