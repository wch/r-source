msgid "error in evaluating the argument '%s' in selecting a method for function '%s': %s"
msgstr "error in evaluating the argument '%s' in selecting a method for function '%s': %s"

#, c-format
msgid "object of class \"%s\" used as methods list for function '%s' ( no 'argument' slot)"
msgstr "object of class \"%s\" used as methods list for function '%s' (no 'argument' slot)"

