msgid "invalid generic function object for method selection for function '%s': expected a function or a primitive, got an object of class \"%s\""
msgstr "invalid generic function object for method selection for function '%s': expected a function or a primitive, got an object of class \"%s\""

#, c-format
msgid "no direct or inherited method for function '%s' for this call"
msgstr "no direct or inherited method for function '%s' for this call"

