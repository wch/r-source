msgstr "use of NULL environment is defunct"

#, c-format
msgid "invalid environment in checking for missing argument, '%s', in methods dispatch: got an object of class \"%s\""
msgstr "invalid environment in checking for missing argument, '%s', in methods dispatch: got an object of class \"%s\""

