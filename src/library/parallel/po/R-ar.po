msgid "invalid value of %s"
msgstr "قيمة %s غير صالحة"

msgid "need at least one argument"
msgstr "يلزم وسيط واحد على الأقل"

msgid "zero-length inputs cannot be mixed with those of non-zero length"
msgstr "لا يمكن خلط المدخلات ذات الطول الصفري مع مدخلات ذات طول غير صفري"

msgid "dim(X) must have a positive length"
msgstr "يجب أن يكون لـ dim(X) طول موجب"

msgid "'X' must have named dimnames"
msgstr "يجب أن تكون لـ 'X' أسماء أبعاد مسماة"

msgid "not all elements of 'MARGIN' are names of dimensions"
msgstr "ليست كل عناصر 'MARGIN' أسماءً للأبعاد"

#, fuzzy
msgid "incompatible arguments"
msgstr "الوسيط 'jobs' غير صالح"

msgid "'Sigma' is not positive definite"
msgstr ""

msgid "no cluster 'cl' supplied and none is registered"
msgstr "لم يُقدَّم العنقود 'cl' ولم يُسجَّل أي عنقود"

msgid "not a valid cluster"
msgstr "ليس عنقودًا صالحًا"

msgid "replacing registration for cluster type '%s'"
msgstr "يُستبدل التسجيل لنوع العنقود '%s'"

msgid "unknown cluster type: '%s'"
msgstr "نوع العنقود غير معروف: '%s'"

msgid "numeric 'names' must be >= 1"
msgstr "يجب أن تكون قيمة 'names' الرقمية أكبر من أو تساوي 1"

msgid "node of a socket cluster on host %s with pid %d"
msgstr "عقدة من عنقود socket على المضيف %s ذات pid %d"

msgid "Connection setup failed or timed out."
msgstr "فشل إعداد الاتصال أو انتهت مهلته."

msgid "PORT must be specified"
msgstr "يجب تحديد PORT"

msgid "'nnodes' must be >= 1"
msgstr "يجب أن تكون قيمة 'nnodes' أكبر من أو تساوي 1"

msgid "Cluster setup failed."
msgstr "فشل إعداد العنقود."

msgid "invalid 'child' argument"
msgstr "الوسيط 'child' غير صالح"

msgid "'children' must be a list of processes or a single process"
msgstr "يجب أن تكون 'children' قائمة عمليات أو عملية واحدة"

msgid "'process' must be of class %s"
msgstr "يجب أن تكون 'process' من الصنف %s"

msgid "'child' must be a valid child process"
msgstr "يجب أن تكون 'child' عملية فرعية صالحة"

msgid "'what' must be a character or raw vector"
msgstr "يجب أن تكون 'what' متجهًا نصيًا أو خامًا"

msgid "'mc.cores' must be >= 1"
msgstr "يجب أن تكون قيمة 'mc.cores' أكبر من أو تساوي 1"

msgid "affinity.list and X must have the same length"
msgstr "يجب أن يكون لكل من affinity.list و X الطول نفسه"

msgid "%d function calls resulted in an error"
msgstr "نتج خطأ عن %d من استدعاءات الدوال"

msgid "'mc.preschedule' must be false if 'affinity.list' is used"
msgstr "يجب أن تكون قيمة 'mc.preschedule' هي false إذا استُخدم 'affinity.list'"

msgid "all scheduled cores encountered errors in user code"
msgstr "واجهت جميع الأنوية المجدولة أخطاءً في كود المستخدم"

msgid "Zero-length inputs cannot be mixed with those of non-zero length"
msgstr "لا يمكن خلط المدخلات ذات الطول الصفري مع مدخلات ذات طول غير صفري"

msgid "invalid 'jobs' argument"
msgstr "الوسيط 'jobs' غير صالح"

msgid "'v' must be a vector"
msgstr "يجب أن يكون 'v' متجهًا"

msgid "some results may be missing, folded or caused an error"
msgstr "قد تكون بعض النتائج مفقودة أو مطوية أو سببت خطأً"

msgid "fork clusters are not supported on Windows"
msgstr "عناقيد fork غير مدعومة على Windows"

msgid "'mc.cores' > 1 is not supported on Windows"
msgstr "القيمة 'mc.cores' > 1 غير مدعومة على Windows"

msgid "Cluster setup failed. %d worker of %d failed to connect."
msgid_plural "Cluster setup failed. %d of %d workers failed to connect."
msgstr[0] "فشل إعداد العنقود. فشل %d من أصل %d من العمال في الاتصال."
msgstr[1] "فشل إعداد العنقود. فشل %d من أصل %d من العمال في الاتصال."
msgstr[2] "فشل إعداد العنقود. فشل %d من أصل %d من العمال في الاتصال."
msgstr[3] "فشل إعداد العنقود. فشل %d من أصل %d من العمال في الاتصال."
msgstr[4] "فشل إعداد العنقود. فشل %d من أصل %d من العمال في الاتصال."
msgstr[5] "فشل إعداد العنقود. فشل %d من أصل %d من العمال في الاتصال."

msgid "socket cluster with %d nodes on host %s"
msgid_plural "socket cluster with %d nodes on hosts %s"
msgstr[0] "عنقود socket يحتوي على %d من العقد على المضيف %s"
msgstr[1] "عنقود socket يحتوي على %d من العقد على المضيف %s"
msgstr[2] "عنقود socket يحتوي على %d من العقد على المضيفين %s"
msgstr[3] "عنقود socket يحتوي على %d من العقد على المضيفين %s"
msgstr[4] "عنقود socket يحتوي على %d من العقد على المضيفين %s"
msgstr[5] "عنقود socket يحتوي على %d من العقد على المضيفين %s"

msgid "%d parallel function call did not deliver a result"
msgid_plural "%d parallel function calls did not deliver results"
msgstr[0] "لم تُرجع %d من استدعاءات الدوال المتوازية نتيجة"
msgstr[1] "لم تُرجع %d من استدعاءات الدوال المتوازية نتيجة"
msgstr[2] "لم تُرجع %d من استدعاءات الدوال المتوازية نتائج"
msgstr[3] "لم تُرجع %d من استدعاءات الدوال المتوازية نتائج"
msgstr[4] "لم تُرجع %d من استدعاءات الدوال المتوازية نتائج"
msgstr[5] "لم تُرجع %d من استدعاءات الدوال المتوازية نتيجة"

msgid "scheduled core %s did not deliver a result, all values of the job will be affected"
msgid_plural "scheduled cores %s did not deliver results, all values of the jobs will be affected"
msgstr[0] "لم تُرجع النواة المجدولة %s نتيجة، وستتأثر جميع قيم المهمة"
msgstr[1] "لم تُرجع النواة المجدولة %s نتيجة، وستتأثر جميع قيم المهمة"
msgstr[2] "لم تُرجع النواتان المجدولتان %s نتائج، وستتأثر جميع قيم المهمتين"
msgstr[3] "لم تُرجع الأنوية المجدولة %s نتائج، وستتأثر جميع قيم المهام"
msgstr[4] "لم تُرجع الأنوية المجدولة %s نتائج، وستتأثر جميع قيم المهام"
msgstr[5] "لم تُرجع النواة المجدولة %s نتيجة، وستتأثر جميع قيم المهمة"

msgid "scheduled core %s encountered error in user code, all values of the job will be affected"
msgid_plural "scheduled cores %s encountered errors in user code, all values of the jobs will be affected"
msgstr[0] "واجهت النواة المجدولة %s خطأً في كود المستخدم، وستتأثر جميع قيم المهمة"
msgstr[1] "واجهت النواة المجدولة %s خطأً في كود المستخدم، وستتأثر جميع قيم المهمة"
msgstr[2] "واجهت النواتان المجدولتان %s أخطاءً في كود المستخدم، وستتأثر جميع قيم المهمتين"
msgstr[3] "واجهت الأنوية المجدولة %s أخطاءً في كود المستخدم، وستتأثر جميع قيم المهام"
msgstr[4] "واجهت الأنوية المجدولة %s أخطاءً في كود المستخدم، وستتأثر جميع قيم المهام"
msgstr[5] "واجهت النواة المجدولة %s خطأً في كود المستخدم، وستتأثر جميع قيم المهمة"

msgid "%d parallel job did not deliver a result"
msgid_plural "%d parallel jobs did not deliver results"
msgstr[0] "لم تُرجع %d من المهام المتوازية نتيجة"
msgstr[1] "لم تُرجع %d من المهام المتوازية نتيجة"
msgstr[2] "لم تُرجع %d من المهام المتوازية نتائج"
msgstr[3] "لم تُرجع %d من المهام المتوازية نتائج"
msgstr[4] "لم تُرجع %d من المهام المتوازية نتائج"
msgstr[5] "لم تُرجع %d من المهام المتوازية نتيجة"
